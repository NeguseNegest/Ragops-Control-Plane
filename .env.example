# API
API_HOST=0.0.0.0
API_PORT=8000
RAGOPS_API_URL=http://127.0.0.1:8000

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# MLflow
# Host-run evaluation scripts use the published Compose port.
# Use http://mlflow:5000 only from another Compose service.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_PORT=5000

# LLM generation
# Keep template for offline development, or choose openai or gemini.
RAGOPS_LLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Python
PYTHONUNBUFFERED=1
